# -------------------------------------------------------------------
# Benchmark Budget Configuration
# Prefix with VITE_BENCH_ to make them available to Vitest via
# import.meta.env.  Set these higher on slower CI machines to avoid
# false-positive regression alerts.
#
# All values are in milliseconds (ms) and represent the maximum
# wall-clock time allowed for 10 000 iterations of the operation.
#
# Examples by platform:
#   Unix/macOS/Git Bash:
#     VITE_BENCH_STORE_ADD_CANDLE_MS=200 npx vitest run src/__tests__/benchmarks/
#   Windows cmd.exe:
#     set VITE_BENCH_STORE_ADD_CANDLE_MS=200 && npx vitest run src/__tests__/benchmarks/
#   PowerShell:
#     $env:VITE_BENCH_STORE_ADD_CANDLE_MS=200; npx vitest run src/__tests__/benchmarks/
# -------------------------------------------------------------------

# Store operations ----------------------------------------------------
# Max time for 10 000 sequential candle inserts
VITE_BENCH_STORE_ADD_CANDLE_MS=80

# Max time for 10 000 sequential quote updates
VITE_BENCH_STORE_UPDATE_QUOTE_MS=80

# Max time for 10 000 mixed store operations (add + update + clear)
VITE_BENCH_STORE_BATCH_OPS_MS=150

# WebSocket operations ------------------------------------------------
# Max time for parsing + dispatching 10 000 JSON messages
VITE_BENCH_WS_JSON_PARSE_DISPATCH_MS=50

# Max time for dispatching 10 000 messages across 5 handlers
VITE_BENCH_WS_HANDLER_FANOUT_MS=80

# Max time for 10 000 subscribe-message serializations
VITE_BENCH_WS_SUBSCRIBE_SERIALIZE_MS=30

# Candle array operations ---------------------------------------------
# Max time for 10 000 push-then-cap-at-1000 operations
VITE_BENCH_CANDLE_ARRAY_CAPPED_PUSH_MS=40

# Max time for 10 000 update-in-place operations
VITE_BENCH_CANDLE_ARRAY_UPDATE_MS=40
